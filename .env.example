# ==============================================================================
# Nwantas Enterprise School Management Platform - Environment Variables Template
# Copy to .env for local overrides
# ==============================================================================

# Core Application Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
NUXT_PUBLIC_APP_NAME="Nwantas"
NUXT_PUBLIC_APP_DESCRIPTION="The Operating System for Modern African & International Schools"

# Multi-Tenancy
DEFAULT_TENANT_ID=apex-academy
ALLOWED_DOMAINS="apexacademy.edu.ng,kingswaycollege.co.uk,localhost"

# Database Configuration (Default: SQLite with WAL mode)
DATABASE_TYPE=sqlite
SQLITE_PATH=.data/nwantas.db

# Optional: Enterprise PostgreSQL Configuration (used when DATABASE_TYPE=postgres)
# DATABASE_URL=postgresql://nwantas_admin:nwantas_secure_password_2026@localhost:5432/nwantas_enterprise

# In-Memory Cache & Pub/Sub (Redis)
REDIS_URL=redis://:nwantas_redis_secret@localhost:6379

# Cryptography & JWT Security
JWT_SECRET=super_secret_jwt_nwantas_enterprise_token_signing_key_2026
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=32_character_aes_encryption_secret_key!

# AI Pedagogical Engine (Lesson Planning, AI Tutor, CBT Diagnostics)
AI_PROVIDER=deepseek # Options: deepseek, openai, anthropic, mock
AI_MODEL=deepseek-chat
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payment Gateway Integrations (Tuition, Levies & Bursary Wallet)
PAYSTACK_PUBLIC_KEY=pk_test_sample_paystack_key
PAYSTACK_SECRET_KEY=sk_test_sample_paystack_key
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-sample
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-sample

# Real-Time Telemetry & Anti-Cheat
CBT_PROCTOR_MAX_TAB_SWITCHES=3
CBT_PROCTOR_DISQUALIFY_ON_VIOLATION=false

# Document & Evidence Storage (Student Photos, Verification IDs, Lesson Notes)
STORAGE_DRIVER=local # Options: local, s3, r2
UPLOAD_MAX_FILE_SIZE_MB=15
